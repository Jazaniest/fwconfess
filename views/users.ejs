<% layout('layout') %>
<div class="flex items-center justify-between mb-4">
  <p class="text-sm text-gray-500">Total: <strong><%= total || users.length %></strong> user(s)</p>
  <a href="/admin/users" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">🔄 Refresh</a>
</div>

<div class="bg-white rounded shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-200 text-left">
      <tr>
        <th class="p-2">ID</th>
        <th class="p-2">Username</th>
        <th class="p-2">Rank</th>
        <th class="p-2">Gender</th>
        <th class="p-2">Origin</th>
        <th class="p-2">Menfess</th>
        <th class="p-2">Status</th>
        <th class="p-2">Daftar</th>
        <th class="p-2">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% (users || []).forEach(u => { %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-2 font-mono text-xs"><%= u.telegram_id %></td>
          <td class="p-2"><%= u.username ? '@' + u.username : '—' %></td>
          <td class="p-2"><%= u.rank || 'member' %></td>
          <td class="p-2"><%= u.gender || '—' %></td>
          <td class="p-2"><%= u.origin || '—' %></td>
          <td class="p-2"><%= u.total_confessions ?? '—' %></td>
          <td class="p-2">
            <% if (u.is_active) { %>
              <span class="text-green-600 font-medium">Aktif</span>
            <% } else { %>
              <span class="text-red-600 font-medium">Banned</span>
            <% } %>
          </td>
          <td class="p-2 text-xs"><%= u.registered_at ? new Date(u.registered_at).toLocaleDateString('id-ID') : '—' %></td>
          <td class="p-2 space-x-1">
            <form action="/admin/users/<%= u.telegram_id %>/suspend" method="POST" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="px-2 py-1 bg-red-500 text-white rounded hover:bg-red-600 text-xs"
                <%= !u.is_active ? 'disabled' : '' %>>Suspend</button>
            </form>
            <form action="/admin/users/<%= u.telegram_id %>/activate" method="POST" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="px-2 py-1 bg-green-500 text-white rounded hover:bg-green-600 text-xs"
                <%= u.is_active ? 'disabled' : '' %>>Activate</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!users || users.length === 0) { %>
        <tr><td colspan="9" class="p-4 text-center text-gray-400">Belum ada user terdaftar.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
  <div class="flex items-center justify-center gap-2 mt-4">
    <% if (page > 0) { %>
      <a href="/admin/users?page=<%= page - 1 %>" class="px-3 py-1 bg-white border rounded hover:bg-gray-100">⬅ Sebelumnya</a>
    <% } %>
    <span class="text-sm text-gray-500">Hal <%= page + 1 %> dari <%= totalPages %></span>
    <% if (page < totalPages - 1) { %>
      <a href="/admin/users?page=<%= page + 1 %>" class="px-3 py-1 bg-white border rounded hover:bg-gray-100">Selanjutnya ➡</a>
    <% } %>
  </div>
<% } %>
