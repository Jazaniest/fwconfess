<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Admin Panel' %> — FWB Confess</title>

  <!-- Modern Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Alpine.js for lightweight interactivity -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Ionicons for modern UI icons -->
  <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .sidebar-link {
      @apply flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-all;
    }
    .sidebar-link.active {
      @apply bg-blue-50 text-blue-600;
    }
    .sidebar-link .icon {
      @apply w-5 h-5 text-gray-400 transition-all;
    }
    .sidebar-link.active .icon {
      @apply text-blue-500;
    }
    .card {
      @apply bg-white rounded-xl shadow-sm border border-gray-200/80;
    }
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-gray-50 text-gray-800" x-data="{ sidebarOpen: false }">
  <div class="flex min-h-screen">
    <!-- Overlay for mobile -->
    <div x-show="sidebarOpen" x-transition:enter="transition-opacity ease-linear duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition-opacity ease-linear duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-900/80 z-30 md:hidden" @click="sidebarOpen = false"></div>

    <!-- Sidebar -->
    <aside
      class="fixed inset-y-0 left-0 w-64 bg-white border-r border-gray-200/80 flex-col shrink-0 z-40 transform md:relative md:translate-x-0 transition-transform duration-300 ease-in-out"
      :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
      x-cloak
    >
      <div class="p-5 border-b border-gray-200/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-500 text-white flex items-center justify-center rounded-lg font-bold text-xl">F</div>
            <div>
                <h2 class="text-base font-bold text-gray-800">FWB Confess</h2>
                <p class="text-xs text-gray-500">Admin Panel</p>
            </div>
        </div>
        <button @click="sidebarOpen = false" class="md:hidden text-gray-500 hover:text-gray-700">
            <ion-icon name="close-outline" class="w-6 h-6"></ion-icon>
        </button>
      </div>
      <nav class="p-4 flex-1 flex flex-col space-y-1">
        <% (nav || []).forEach(item => { %>
          <a href="<%= item.url %>" class="sidebar-link<%= item.active ? ' active' : '' %>">
            <ion-icon name="<%= item.icon || 'ellipse-outline' %>" class="icon"></ion-icon>
            <span><%= item.label %></span>
          </a>
        <% }) %>
      </nav>
      <div class="p-4 border-t border-gray-200/80">
        <a href="#" class="sidebar-link">
            <ion-icon name="log-out-outline" class="icon"></ion-icon>
            <span>Logout</span>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col w-full">
      <!-- Top Bar -->
      <header class="bg-white/80 backdrop-blur-sm border-b border-gray-200/80 sticky top-0 z-20">
        <div class="px-4 md:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center">
                <button @click="sidebarOpen = true" class="md:hidden mr-4 text-gray-600 hover:text-gray-800">
                    <ion-icon name="menu-outline" class="w-6 h-6"></ion-icon>
                </button>
                <h1 class="text-lg font-semibold text-gray-900"><%= title || 'Dashboard' %></h1>
            </div>
            <div class="hidden sm:flex items-center gap-2 text-sm text-gray-500">
                <ion-icon name="time-outline"></ion-icon>
                <span><%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 p-4 md:p-6">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>
