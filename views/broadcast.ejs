<!-- <% layout('layout', { title: 'Broadcast Message' }) %> -->
<form action="/admin/broadcast" method="POST" class="max-w-xl bg-white p-4 rounded shadow">
  <textarea name="message_text" rows="4" class="w-full border rounded p-2" placeholder="Tulis pesan broadcast..."></textarea>
  <button type="submit" class="mt-3 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Send to All</button>
</form>


<!-- views/statistics.ejs -->
<% layout('layout', { title: 'Statistics' }) %>
<div class="grid grid-cols-2 gap-4">
  <div class="bg-white p-4 rounded shadow">
    <h2 class="text-lg font-medium">Total Users</h2>
    <p class="text-3xl"><%= totalUsers %></p>
  </div>
  <div class="bg-white p-4 rounded shadow">
    <h2 class="text-lg font-medium">Total Messages</h2>
    <p class="text-3xl"><%= totalMessages %></p>
  </div>
</div>