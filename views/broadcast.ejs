

<form action="/admin/broadcast/send" method="POST" class="max-w-2xl bg-white p-6 rounded shadow space-y-4">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div>
    <label class="block text-sm font-medium mb-1">Jenis Broadcast</label>
    <select name="target_type" class="w-full border rounded p-2 text-sm">
      <option value="all">📢 Semua User</option>
      <option value="active">✅ User Aktif Saja</option>
      <option value="inactive">🚫 User Terbanned Saja</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1">Pesan Broadcast</label>
    <textarea name="message_text" rows="6" class="w-full border rounded p-2 text-sm" placeholder="Tulis pesan broadcast di sini..."></textarea>
    <p class="text-xs text-gray-400 mt-1">Support Markdown Telegram: *bold* _italic* `code`</p>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1">
      <input type="checkbox" name="preview" value="1" class="mr-1" />
      Kirim ke saya dulu sebagai preview (sebelum broadcast ke semua)
    </label>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium">
      📤 Kirim Broadcast
    </button>
    <a href="/admin/broadcast/history" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300 text-sm">📜 Riwayat</a>
  </div>
</form>

<% if (typeof lastBroadcasts !== 'undefined' && lastBroadcasts.length > 0) { %>
  <div class="mt-6">
    <h2 class="text-lg font-medium mb-2">Broadcast Terakhir</h2>
    <div class="bg-white rounded shadow divide-y">
      <% lastBroadcasts.forEach(b => { %>
        <div class="p-3">
          <p class="text-sm text-gray-700"><%= b.message_text %></p>
          <p class="text-xs text-gray-400 mt-1"><%= new Date(b.sent_at).toLocaleString('id-ID') %></p>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>
