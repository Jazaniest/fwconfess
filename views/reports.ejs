<% layout('layout') %>

<% if (typeof stats !== 'undefined') { %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
    <div class="bg-white p-3 rounded shadow text-center">
      <p class="text-xs text-gray-500">Total</p>
      <p class="text-xl font-bold"><%= stats.total %></p>
    </div>
    <div class="bg-white p-3 rounded shadow text-center">
      <p class="text-xs text-gray-500">Pending</p>
      <p class="text-xl font-bold text-yellow-600"><%= stats.pending %></p>
    </div>
    <div class="bg-white p-3 rounded shadow text-center">
      <p class="text-xs text-gray-500">Handled</p>
      <p class="text-xl font-bold text-green-600"><%= stats.handled %></p>
    </div>
    <div class="bg-white p-3 rounded shadow text-center">
      <p class="text-xs text-gray-500">Ditolak</p>
      <p class="text-xl font-bold text-red-600"><%= stats.rejected %></p>
    </div>
  </div>
<% } %>

<div class="bg-white rounded shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-200 text-left">
      <tr>
        <th class="p-2">#</th>
        <th class="p-2">Reporter</th>
        <th class="p-2">Target</th>
        <th class="p-2">Alasan</th>
        <th class="p-2">Status</th>
        <th class="p-2">Tanggal</th>
      </tr>
    </thead>
    <tbody>
      <% (reports || []).forEach(r => { %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-2 text-xs text-gray-400"><%= r.id %></td>
          <td class="p-2 font-mono text-xs"><%= r.reporter_id %></td>
          <td class="p-2 text-xs"><%= r.confessor_id || r.target_message_id || '—' %></td>
          <td class="p-2"><%= r.reason %></td>
          <td class="p-2">
            <% if (r.status === 'pending') { %><span class="text-yellow-600 font-medium">Pending</span>
            <% } else if (r.status === 'handled') { %><span class="text-green-600 font-medium">Handled</span>
            <% } else { %><span class="text-red-600 font-medium">Rejected</span>
            <% } %>
          </td>
          <td class="p-2 text-xs"><%= new Date(r.created_at).toLocaleString('id-ID') %></td>
        </tr>
      <% }) %>
      <% if (!reports || reports.length === 0) { %>
        <tr><td colspan="6" class="p-4 text-center text-gray-400">Belum ada laporan.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
