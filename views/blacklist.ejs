<!-- <% layout('layout', { title: 'Blacklist Words' }) %> -->
<form action="/admin/blacklist" method="POST" class="mb-4">
  <input name="word" type="text" class="border rounded p-2" placeholder="Add new word" />
  <button type="submit" class="px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600">Add</button>
</form>
<ul class="bg-white p-4 rounded shadow">
  <% words.forEach(w => { %>
    <li class="border-b py-1"><%= w.word %></li>
  <% }) %>
</ul>