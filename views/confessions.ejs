
<div class="flex items-center justify-between mb-4">
  <p class="text-sm text-gray-500">Total: <strong><%= total || confessions.length %></strong> confession(s)</p>
  <a href="/admin/confessions" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">🔄 Refresh</a>
</div>

<div class="bg-white rounded shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-200 text-left">
      <tr>
        <th class="p-2">#</th>
        <th class="p-2">User ID</th>
        <th class="p-2">Pesan</th>
        <th class="p-2">Channel Msg ID</th>
        <th class="p-2">Tanggal</th>
      </tr>
    </thead>
    <tbody>
      <% (confessions || []).forEach(c => { %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-2 text-xs text-gray-400"><%= c.id %></td>
          <td class="p-2 font-mono text-xs"><%= c.telegram_id %></td>
          <td class="p-2 max-w-xs truncate"><%= (c.message_text || '').substring(0, 80) %></td>
          <td class="p-2 text-xs"><%= c.channel_message_id || '—' %></td>
          <td class="p-2 text-xs"><%= c.created_at ? new Date(c.created_at).toLocaleString('id-ID') : '—' %></td>
        </tr>
      <% }) %>
      <% if (!confessions || confessions.length === 0) { %>
        <tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada confession.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
  <div class="flex items-center justify-center gap-2 mt-4">
    <% if (page > 0) { %>
      <a href="/admin/confessions?page=<%= page - 1 %>" class="px-3 py-1 bg-white border rounded hover:bg-gray-100">⬅ Sebelumnya</a>
    <% } %>
    <span class="text-sm text-gray-500">Hal <%= page + 1 %> dari <%= totalPages %></span>
    <% if (page < totalPages - 1) { %>
      <a href="/admin/confessions?page=<%= page + 1 %>" class="px-3 py-1 bg-white border rounded hover:bg-gray-100">Selanjutnya ➡</a>
    <% } %>
  </div>
<% } %>
